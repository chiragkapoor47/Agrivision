# TAH-015: Environment Configuration
# Project Name
PROJECT_NAME="TAH-015 Crop Disease Predictor"

# Secret Key for JWT Signing
SECRET_KEY="super-secret-agricultural-jwt-key-2026-tah015-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL:
# For local zero-setup execution (Default):
DATABASE_URL="sqlite:///./crop_disease_app.db"

# For PostgreSQL / Supabase in Production:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT].supabase.co:5432/postgres"

# Server Port
PORT=8000
HOST="0.0.0.0"

# Upload Storage Directory
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=15

# OpenWeatherMap or AgroMonitoring API Key (Optional fallback weather intelligence)
AGRO_WEATHER_API_KEY=""
